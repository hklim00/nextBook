---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="페이지를 찾을 수 없음">
  <div class="shell not-found">
    <span>404</span>
    <h1 class="serif">이 페이지는 아직 발견되지 않았어요.</h1>
    <a class="btn primary" href="/">
      발견으로 돌아가기
    </a>
  </div>
  <style>
    .not-found {
      text-align: center;
      padding: 140px 0;
    }
    .not-found span {
      color: var(--accent);
      font-weight: 900;
    }
    .not-found h1 {
      font-size: clamp(1.5rem, 4vw, 2.2rem);
      margin: 15px auto 30px;
      max-width: 700px;
    }
  </style>
</BaseLayout>
