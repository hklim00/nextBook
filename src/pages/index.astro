---
import BaseLayout from '../layouts/BaseLayout.astro';
import BookCard from '../components/BookCard.astro';
import BookCover from '../components/BookCover.astro';
import { env } from 'cloudflare:workers';
import { loadCatalog } from '../repositories/catalogRepository';

const { books, collections, collectionBooks } = await loadCatalog(env.DB);
const dailyShelves = collections
  .filter(
    (collection) =>
      (collection.source === 'data4library' || collection.source === 'manual') &&
      collection.collectionType !== 'publisher_discovery' &&
      collection.collectionType !== 'publisher',
  )
  .sort((a, b) => a.displayOrder - b.displayOrder)
  .map((collection) => ({
    collection,
    items: collectionBooks
      .filter((item) => item.collectionId === collection.id)
      .sort((a, b) => a.displayOrder - b.displayOrder)
      .slice(0, 6)
      .map((item) => ({ book: books.find((book) => book.id === item.bookId), reason: item.reason }))
      .filter((item): item is { book: (typeof books)[number]; reason: string } =>
        Boolean(item.book),
      ),
  }));
const surpriseShelf = dailyShelves.find(
  ({ collection }) =>
    collection.slug === 'daily-serendipity' || collection.collectionType === 'random',
);
const surprisePreview = surpriseShelf?.items.find(({ book }) => book.metadataSource !== 'mock');
const heroBook = surprisePreview?.book;

const apiRecipe = (slug: string) => {
  if (slug === 'daily-serendipity')
    return '도서관 최근 등록(itemSrch) 2권 + 월간 관심어와 핵심어 교차(monthlyKeywords→srchBooks→keywordList) 2권 + 마니아 추천(usageAnalysisList) 1권 + 인기 상위권을 벗어난 장기 후보(loanItemSrch) 1권 → 도서 상세조회(srchDtlList)';
  if (slug === 'classics')
    return '작품 단위 고전 목록을 날짜별 무작위로 섞음 → 판본 검색(srchBooks) → 아동·축약·만화판 제외 → 도서 상세조회(srchDtlList)';
  if (slug === 'outside-literature')
    return '도서관 최근 등록(itemSrch) + 월간 관심어 옆길(monthlyKeywords→keywordList) + 장기 후보(loanItemSrch) → KDC 문학 제외 → 서로 다른 분야 선택 → 도서 상세조회(srchDtlList)';
  if (slug === 'rising-economy')
    return '대출 급상승 도서(hotTrend) → KDC 경제·경영/경제 주제 필터 → 상승 폭 순 → 도서 상세조회(srchDtlList)';
  if (slug === 'data-career-starter')
    return '‘데이터 분석’ 검색(srchBooks) → ISBN 부가기호 성인 필터 → 데이터 관련 도서 핵심어 확인(keywordList) → 월간 관심 키워드(monthlyKeywords) 보조 가중치 → 상세조회(srchDtlList)';
  if (slug === 'startup-keywords')
    return '월간 관심 키워드(monthlyKeywords) + ‘창업’ 검색(srchBooks) + 도서별 핵심어 가중치(keywordList) → 상세조회(srchDtlList)';
  if (slug === 'philosophy-keywords')
    return '월간 관심 키워드(monthlyKeywords) + ‘철학’ 검색(srchBooks) + 도서별 핵심어 가중치(keywordList) → 상세조회(srchDtlList)';
  if (slug === 'monthly-keyword')
    return '월간 관심 키워드(monthlyKeywords) → 주제어 검색(srchBooks) → 도서별 핵심어 가중치(keywordList) 교차 확인 → 상세조회(srchDtlList)';
  return null;
};
---

<BaseLayout description="검색하지 않았을 책을 발견하는 곳. 출처와 맥락, 적절한 우연으로 다음 책을 만납니다.">
  <header class="hero shell">
    {surprisePreview && heroBook ? (
      <a
        class="featured"
        href={`/book/${heroBook.id}`}
        aria-label={`오늘의 뜻밖의 한 권: ${heroBook.title}`}
      >
        <div class="featured-cover">
          <BookCover book={heroBook} />
        </div>
      </a>
    ) : null}
  </header>

  <main id="shelves" class="shell shelves">
    {dailyShelves.length > 0 ? (
      dailyShelves.map(({ collection, items }) => (
        <section class="shelf" id={collection.slug}>
          <div class="section-head">
            <div>
              <span class="eyebrow">
                {collection.source === 'manual'
                  ? '에디터 추천'
                  : `오늘의 발견 ${String(collection.displayOrder).padStart(2, '0')}`}
              </span>
              <h2 class="serif">{collection.title}</h2>
              <p>{collection.description}</p>
              {apiRecipe(collection.slug) && (
                <div class="method">
                  <strong>정보나루 조합</strong>
                  <span>{apiRecipe(collection.slug)}</span>
                </div>
              )}
            </div>
          </div>
          <div class="book-grid">
            {items.map(({ book, reason }) => (
              <BookCard book={book} reason={reason} showReason={false} />
            ))}
          </div>
        </section>
      ))
    ) : (
      <section class="sync-empty">
        <span class="eyebrow">Daily sync pending</span>
        <h2 class="serif">첫 번째 일일 수집을 기다리고 있습니다.</h2>
        <p>
          수집 전에는 Mock 카테고리를 대신 표시하지 않습니다. Cron이 완료되면 D1에 저장된 책장이
          이곳에 나타납니다.
        </p>
      </section>
    )}
  </main>

  <style>
    .hero {
      min-height: 190px;
      display: grid;
      justify-items: center;
      align-items: center;
      padding-block: 24px 32px;
    }
    .featured {
      display: grid;
      grid-template-columns: 104px;
      align-items: center;
      gap: 18px;
      width: fit-content;
      justify-self: center;
      padding: 18px;
      border: 1px solid var(--line);
      border-radius: 18px;
      background: #fffdf8cc;
      box-shadow: 0 16px 40px #1e302a12;
      transition: transform 0.2s ease;
    }
    .featured:hover {
      transform: translateY(-4px);
    }
    .featured-cover {
      width: 104px;
    }
    .featured-copy {
      min-width: 0;
    }
    .featured-copy h2 {
      margin: 7px 0 3px;
      font-size: clamp(1.25rem, 2.2vw, 1.75rem);
      line-height: 1.2;
      word-break: keep-all;
    }
    .featured-by {
      margin: 0;
      color: var(--muted);
      font-size: 0.82rem;
    }
    .featured-hook {
      margin-top: 15px;
      padding-left: 11px;
      border-left: 2px solid var(--accent);
    }
    .featured-hook strong {
      color: var(--green);
      font-size: 0.72rem;
    }
    .featured-hook p,
    .featured-description {
      margin: 4px 0 0;
      color: #47544d;
      font-size: 0.78rem;
      line-height: 1.58;
    }
    .featured-description {
      display: -webkit-box;
      margin-top: 11px;
      overflow: hidden;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 3;
    }
    .featured-meta {
      display: flex;
      flex-wrap: wrap;
      gap: 5px;
      margin-top: 12px;
    }
    .featured-meta span {
      padding: 4px 8px;
      border-radius: 999px;
      background: #edf0e8;
      color: var(--muted);
      font-size: 0.66rem;
    }
    .featured-link {
      display: inline-block;
      margin-top: 13px;
      color: var(--green);
      font-size: 0.75rem;
      font-weight: 800;
    }
    .shelves {
      padding-block: 80px;
    }
    .shelf {
      padding: 30px 0 76px;
      border-bottom: 1px solid var(--line);
      scroll-margin-top: 120px;
    }
    .section-head {
      align-items: start;
    }
    .section-head p {
      max-width: 560px;
      margin: 8px 0 0;
      color: var(--muted);
      font-size: 0.86rem;
      line-height: 1.6;
    }
    .section-head small {
      display: block;
      margin-top: 8px;
      color: var(--muted);
      font-size: 0.68rem;
    }
    .method {
      display: flex;
      align-items: flex-start;
      gap: 8px;
      max-width: 820px;
      margin-top: 10px;
      color: var(--muted);
      font-size: 0.7rem;
      line-height: 1.55;
    }
    .method strong {
      flex: 0 0 auto;
      color: var(--green);
    }
    .sync-empty {
      min-height: 360px;
      display: grid;
      align-content: center;
      justify-items: center;
      text-align: center;
    }
    .sync-empty h2 {
      font-size: clamp(1.45rem, 3vw, 2rem);
      margin: 12px 0;
    }
    .sync-empty p {
      max-width: 600px;
      color: var(--muted);
      line-height: 1.7;
    }
    @media (min-width: 800px) {
      .featured {
        grid-template-columns: 138px;
        padding: 18px;
      }
      .featured-cover {
        width: 138px;
      }
    }
    @media (min-width: 900px) {
      :global(.shelves .book-grid) {
        grid-template-columns: repeat(6, minmax(0, 132px));
        justify-content: space-between;
        gap: 28px 18px;
      }
      :global(.shelves .book-card),
      :global(.shelves .book-card .cover) {
        max-width: 132px;
      }
    }
  </style>
</BaseLayout>
