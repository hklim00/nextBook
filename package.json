{
  "name": "next-read",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.3"
  },
  "scripts": {
    "dev": "cross-env ASTRO_TELEMETRY_DISABLED=1 XDG_CONFIG_HOME=.wrangler/config astro dev",
    "build": "cross-env ASTRO_TELEMETRY_DISABLED=1 XDG_CONFIG_HOME=.wrangler/config astro check && cross-env ASTRO_TELEMETRY_DISABLED=1 XDG_CONFIG_HOME=.wrangler/config astro build",
    "preview": "cross-env ASTRO_TELEMETRY_DISABLED=1 XDG_CONFIG_HOME=.wrangler/config astro preview",
    "typecheck": "cross-env ASTRO_TELEMETRY_DISABLED=1 XDG_CONFIG_HOME=.wrangler/config astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:seed:generate": "tsx scripts/generate-seed.ts",
    "db:migrate:local": "cross-env XDG_CONFIG_HOME=.wrangler/config wrangler d1 migrations apply next-read-db --local",
    "db:seed:local": "npm run db:seed:generate && cross-env XDG_CONFIG_HOME=.wrangler/config wrangler d1 execute next-read-db --local --file=./src/db/seed.sql",
    "deploy": "npm run build && cross-env XDG_CONFIG_HOME=.wrangler/config wrangler deploy"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "description": "검색하지 않았을 책을 발견하는 모바일 우선 웹앱",
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.1",
    "@astrojs/react": "^6.0.5",
    "astro": "^7.3.2",
    "drizzle-orm": "^0.45.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/workers-types": "^5.20260915.1",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.10.0",
    "eslint-plugin-astro": "^3.1.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^1.0.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1",
    "wrangler": "^4.132.0"
  }
}
